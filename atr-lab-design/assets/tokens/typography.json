{
  "$description": "ATR Lab typography tokens (DTCG). Generated by src/build_tokens.py.",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Source Sans 3",
          "Source Sans Pro",
          "Arial",
          "Helvetica Neue",
          "Helvetica",
          "sans-serif"
        ],
        "$description": "Workhorse: headlines (Black/Bold), subheads (Semibold), body (Regular), captions (Regular/Light)."
      },
      "slab": {
        "$type": "fontFamily",
        "$value": [
          "Roboto Slab",
          "Georgia",
          "Times New Roman",
          "serif"
        ],
        "$description": "Accent only: big stat numerals, pull quotes, section numerals."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "Source Code Pro",
          "Menlo",
          "Consolas",
          "Courier New",
          "monospace"
        ],
        "$description": "Code, ROS topics, CLI, technical labels, coordinates."
      }
    },
    "weight": {
      "extralight": {
        "$type": "fontWeight",
        "$value": 200
      },
      "light": {
        "$type": "fontWeight",
        "$value": 300
      },
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      },
      "extrabold": {
        "$type": "fontWeight",
        "$value": 800,
        "$description": "800 exists only in the Google Fonts variable font (web). The static TTF kit and Office have no Source Sans 3 ExtraBold, so 800 falls back to Black (900) there; roles use 700 or 900 instead."
      },
      "black": {
        "$type": "fontWeight",
        "$value": 900
      }
    },
    "scale": {
      "$description": "Web modular scale: ratio 1.25 (major third), step 0 = 1.125rem (18px at a 16px root).",
      "ratio": {
        "$type": "number",
        "$value": 1.25
      },
      "step-1": {
        "$type": "dimension",
        "$value": "0.9rem",
        "$description": "14.4px"
      },
      "step0": {
        "$type": "dimension",
        "$value": "1.125rem",
        "$description": "18.0px"
      },
      "step1": {
        "$type": "dimension",
        "$value": "1.406rem",
        "$description": "22.5px"
      },
      "step2": {
        "$type": "dimension",
        "$value": "1.758rem",
        "$description": "28.1px"
      },
      "step3": {
        "$type": "dimension",
        "$value": "2.197rem",
        "$description": "35.2px"
      },
      "step4": {
        "$type": "dimension",
        "$value": "2.747rem",
        "$description": "44.0px"
      },
      "step5": {
        "$type": "dimension",
        "$value": "3.433rem",
        "$description": "54.9px"
      },
      "step6": {
        "$type": "dimension",
        "$value": "4.292rem",
        "$description": "68.7px"
      }
    },
    "role": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontWeight": 900,
          "fontSize": "4.292rem",
          "lineHeight": 1.05,
          "letterSpacing": "-0.015em"
        }
      },
      "h1": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontWeight": 700,
          "fontSize": "3.433rem",
          "lineHeight": 1.1,
          "letterSpacing": "-0.01em"
        }
      },
      "h2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontWeight": 700,
          "fontSize": "2.747rem",
          "lineHeight": 1.15,
          "letterSpacing": "-0.005em"
        }
      },
      "h3": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontWeight": 700,
          "fontSize": "2.197rem",
          "lineHeight": 1.2,
          "letterSpacing": "0em"
        }
      },
      "h4": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontWeight": 600,
          "fontSize": "1.758rem",
          "lineHeight": 1.25,
          "letterSpacing": "0em"
        }
      },
      "h5": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontWeight": 600,
          "fontSize": "1.406rem",
          "lineHeight": 1.3,
          "letterSpacing": "0em"
        }
      },
      "lead": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontWeight": 400,
          "fontSize": "1.406rem",
          "lineHeight": 1.45,
          "letterSpacing": "0em"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontWeight": 400,
          "fontSize": "1.125rem",
          "lineHeight": 1.55,
          "letterSpacing": "0em"
        }
      },
      "small": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontWeight": 400,
          "fontSize": "0.9rem",
          "lineHeight": 1.45,
          "letterSpacing": "0.005em"
        }
      },
      "eyebrow": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontWeight": 600,
          "fontSize": "0.9rem",
          "lineHeight": 1.3,
          "letterSpacing": "0.08em"
        },
        "$description": "Uppercase. Bronze on light, gold on navy."
      },
      "stat": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.slab}",
          "fontWeight": 700,
          "fontSize": "4.292rem",
          "lineHeight": 1.0,
          "letterSpacing": "-0.01em"
        }
      },
      "code": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.mono}",
          "fontWeight": 400,
          "fontSize": "0.9rem",
          "lineHeight": 1.5,
          "letterSpacing": "0em"
        }
      }
    },
    "slide": {
      "$description": "Slide sizes in pt for 16:9 decks. 14 pt is the floor for projected text; 18 pt+ for body.",
      "caption": {
        "$type": "dimension",
        "$value": "14pt"
      },
      "body": {
        "$type": "dimension",
        "$value": "18pt"
      },
      "subhead": {
        "$type": "dimension",
        "$value": "24pt"
      },
      "title": {
        "$type": "dimension",
        "$value": "32pt"
      },
      "section": {
        "$type": "dimension",
        "$value": "44pt"
      },
      "display": {
        "$type": "dimension",
        "$value": "60pt"
      },
      "stat": {
        "$type": "dimension",
        "$value": "80pt"
      }
    },
    "paper": {
      "$description": "IEEE-style paper figures at final printed size (3.5 in / 7.16 in columns).",
      "figure-text": {
        "$type": "dimension",
        "$value": "8pt"
      },
      "figure-title": {
        "$type": "dimension",
        "$value": "9pt"
      },
      "caption": {
        "$type": "dimension",
        "$value": "8pt"
      },
      "body": {
        "$type": "dimension",
        "$value": "10pt"
      }
    },
    "poster": {
      "$description": "Research posters (36 x 48 in or A0) at 100% print size.",
      "caption": {
        "$type": "dimension",
        "$value": "24pt"
      },
      "body": {
        "$type": "dimension",
        "$value": "32pt"
      },
      "subhead": {
        "$type": "dimension",
        "$value": "48pt"
      },
      "section": {
        "$type": "dimension",
        "$value": "60pt"
      },
      "title": {
        "$type": "dimension",
        "$value": "96pt"
      }
    }
  }
}
